<Window
    x:Class="LibreStream.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LibreStream.App"
    xmlns:core="using:LibreStream.Core"
    Title="Nsound">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource NsBgBrush}">
        <Grid.Resources>
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!-- Tarjeta apaisada (vídeo) -->
            <DataTemplate x:Key="VideoCard" x:DataType="local:MediaCard">
                <Button Style="{StaticResource CardButton}" Tag="{x:Bind}" Click="Card_Click" RightTapped="Card_RightTapped" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                    <StackPanel Width="256" Spacing="6">
                        <Grid Height="144" CornerRadius="12" Background="{x:Bind Tile}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="40" FontWeight="Bold" Opacity="0.85"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                            <Border Background="#B0000000" CornerRadius="4" Padding="6,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind DurationText}" FontSize="12" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- Tarjeta cuadrada (música) -->
            <DataTemplate x:Key="TrackCard" x:DataType="local:MediaCard">
                <Button Style="{StaticResource CardButton}" Tag="{x:Bind}" Click="Card_Click" RightTapped="Card_RightTapped" PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                    <StackPanel Width="160" Spacing="6">
                        <Grid Height="160" CornerRadius="12" Background="{x:Bind Tile}">
                            <TextBlock Text="{x:Bind Initials}" FontSize="44" FontWeight="Bold" Opacity="0.9"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Artwork}" Stretch="UniformToFill" />
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brillo ambiental: cambia de color con cada canción -->
        <Rectangle x:Name="Ambient" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0.3,0.7">
                    <GradientStop x:Name="AmbientStop" Color="#4DFF4D62" Offset="0" />
                    <GradientStop x:Name="AmbientEnd" Color="#00FF4D62" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="AmbientBlue" Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0.6,0.35">
                    <GradientStop x:Name="AmbientBlueStop" Color="#333B82F6" Offset="0" />
                    <GradientStop x:Name="AmbientBlueEnd" Color="#003B82F6" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Barra de título -->
        <Grid x:Name="TitleBar">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon-64.png" Width="18" Height="18" />
                <TextBlock Text="Nsound" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navegación + contenido -->
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        SelectionChanged="Nav_SelectionChanged" ItemInvoked="Nav_ItemInvoked">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Buscar" QueryIcon="Find" TextChanged="Search_TextChanged" QuerySubmitted="Search_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Inicio" Icon="Home" Tag="all" IsSelected="True" />
                <NavigationViewItem Content="Música" Icon="Audio" Tag="track" />
                <NavigationViewItem Content="Vídeos" Icon="Video" Tag="video" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Mi biblioteca" Icon="Library" Tag="library" />
                <NavigationViewItem Content="Descargas" Icon="Download" Tag="downloads" />
                <NavigationViewItemHeader Content="Tus listas" />
                <NavigationViewItem x:Name="NewListItem" Content="Nueva lista" Icon="Add" Tag="newlist" SelectsOnInvoked="False" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ajustes" Icon="Setting" Tag="settings" />
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Letra sincronizada (LRCLIB) -->
                <Grid x:Name="LyricsPanel" Grid.Column="1" Width="340" Padding="16,20,12,12" RowSpacing="8"
                      Background="{StaticResource NsPanelBrush}" BorderBrush="{StaticResource NsLineBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Letra" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LyricsInfo" Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" />
                    <ListView x:Name="LyricsList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Lyrics_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:LyricLine">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer x:Name="Browse" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="28,20,28,28" Spacing="14">

                        <TextBlock x:Name="PageTitle" Text="Inicio" Style="{StaticResource TitleTextBlockStyle}" Margin="8,0,0,0" />
                        <TextBlock x:Name="PageHint" Opacity="0.7" Margin="8,-8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                        <StackPanel x:Name="PlaylistActions" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click" AutomationProperties.Name="Reproducir todo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Reproducir todo" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Content="Eliminar lista" Click="DeleteList_Click" />
                        </StackPanel>
                        <StackPanel x:Name="LibraryActions" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button Click="ExportLibrary_Click" AutomationProperties.Name="Exportar la biblioteca a un archivo">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Exportar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ScopeChips" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="Genres" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" Visibility="Collapsed" />

                        <!-- Destacado -->
                        <Grid x:Name="Hero" Height="300" CornerRadius="26" Visibility="Collapsed">
                            <Border x:Name="HeroTile" />
                            <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.8" RenderTransformOrigin="0.7,0.4">
                                <Image.RenderTransform><ScaleTransform x:Name="HeroScale" ScaleX="1.02" ScaleY="1.02" /></Image.RenderTransform>
                            </Image>
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E6000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Rectangle x:Name="HeroSlash" Width="70" Height="460" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,180,0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><SkewTransform AngleX="-18" /></Rectangle.RenderTransform>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop x:Name="SlashA" Color="#00FF4D62" Offset="0" />
                                        <GradientStop x:Name="SlashB" Color="#66FF4D62" Offset="0.5" />
                                        <GradientStop x:Name="SlashC" Color="#00FF4D62" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Bottom" Margin="32" Spacing="6" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock x:Name="HeroLabel" Foreground="White" Text="NUEVO LANZAMIENTO" FontSize="12" CharacterSpacing="120" Opacity="0.85" />
                                <TextBlock x:Name="HeroTitle" Foreground="White" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroSubtitle" Foreground="White" Opacity="0.8" />
                                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0" Padding="20,8" Click="Hero_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Play" />
                                        <TextBlock Text="Reproducir" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="HeroDots" Orientation="Horizontal" Spacing="6" Margin="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>

                        <TextBlock x:Name="Status" Foreground="#FF8A80" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="YouTubeSection" Spacing="6" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,8,0,0">
                                <TextBlock x:Name="YouTubeTitle" Text="YouTube" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ProgressRing x:Name="YouTubeBusy" IsActive="False" Width="18" Height="18" />
                            </StackPanel>
                            <TextBlock x:Name="YouTubeInfo" Opacity="0.7" Margin="8,0,0,0" />
                            <ItemsRepeater x:Name="YouTubeRepeater" ItemTemplate="{StaticResource VideoCard}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel x:Name="ShelvesHost" Spacing="14" Visibility="Collapsed">
                            <ProgressRing x:Name="ShelvesBusy" IsActive="False" Width="22" Height="22" HorizontalAlignment="Left" Margin="8,0,0,0" />
                            <TextBlock x:Name="ShelvesInfo" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="SavedSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="SavedTitle" Text="Guardado" Style="{StaticResource SubtitleTextBlockStyle}" Margin="8,8,0,0" />
                            <TextBlock x:Name="SavedEmpty" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Aún no has guardado nada. Reproduce algo y pulsa el corazón de la barra inferior." />
                            <ItemsRepeater x:Name="SavedRepeater" ItemTemplate="{StaticResource VideoCard}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>

                        <StackPanel x:Name="DownloadsSection" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Descargado" Style="{StaticResource SubtitleTextBlockStyle}" Margin="8,8,0,0" />
                            <TextBlock x:Name="DownloadsEmpty" Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Todavía no has descargado nada. Elige algo de la lista de abajo." />
                            <StackPanel x:Name="DownloadedHost" Spacing="6" />
                            <TextBlock Text="Contenido libre para descargar" Style="{StaticResource SubtitleTextBlockStyle}" Margin="8,16,0,0" />
                            <TextBlock Opacity="0.7" Margin="8,0,0,0" TextWrapping="Wrap"
                                       Text="Películas y cortos con licencia Creative Commons: puedes guardarlos y verlos sin conexión. YouTube no permite descargar sus vídeos, por eso aquí solo aparece contenido libre." />
                            <StackPanel x:Name="AvailableHost" Spacing="6" />
                        </StackPanel>

                        <StackPanel x:Name="SettingsSection" Spacing="22" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left" Margin="8,0,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Aspecto" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ComboBox x:Name="LookBox" Header="Estilo" Width="240" SelectionChanged="Look_Changed" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Cambia colores, brillo y animaciones al momento. «Clásico» es el aspecto de siempre." />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Ecualizador" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="EqToggle" Header="Activar ecualizador" OnContent="Activado" OffContent="Desactivado" Toggled="EqToggle_Toggled" />
                                <ComboBox x:Name="EqPresetBox" Header="Ajuste" Width="220" SelectionChanged="EqPreset_Changed" />
                                <StackPanel x:Name="EqBandsHost" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" />
                                <TextBlock x:Name="EqStatus" Opacity="0.8" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Actúa sobre el sonido de YouTube dentro de la app. Los vídeos del catálogo libre no admiten ecualizador." />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Descargas" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="DownloadFolderText" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Cambiar carpeta" Click="ChangeFolder_Click" />
                                    <Button Content="Abrir carpeta" Click="OpenFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="Privacidad" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <ToggleSwitch x:Name="AdBlockToggle" Header="Bloquear anuncios y rastreadores" OnContent="Activado" OffContent="Desactivado" Toggled="AdBlock_Toggled" />
                                <TextBlock Opacity="0.55" FontSize="12" TextWrapping="Wrap"
                                           Text="Corta las conexiones a servidores de publicidad conocidos. Los anuncios que YouTube sirve desde sus propios servidores de vídeo pueden seguir apareciendo." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Reproductor oficial de YouTube embebido, controlado por la barra de la app -->
                <Grid x:Name="YouTubeLayer" Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <WebView2 x:Name="YouTubePlayer" Margin="0,56,0,0" />
                    <Button Margin="12" VerticalAlignment="Top" Click="CloseLayer_Click" ToolTipService.ToolTip="Ocultar vídeo (sigue sonando)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="Volver" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Reproductor de vídeo a pantalla completa del área de contenido -->
                <Grid x:Name="VideoLayer" Background="Black" Visibility="Collapsed">
                    <MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="False" Stretch="Uniform" />
                    <Button Margin="16" VerticalAlignment="Top" Click="CloseLayer_Click" ToolTipService.ToolTip="Ocultar vídeo (sigue sonando)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Back" />
                            <TextBlock Text="Volver" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Barra de reproducción -->
        <Grid x:Name="Bar" Grid.Row="2" Margin="12,4,12,12" CornerRadius="22" Padding="16,10" ColumnSpacing="16"
              Background="{StaticResource NsBarBrush}" BorderBrush="{StaticResource NsLineBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Background="Transparent" Tapped="Now_Tapped">
                <Grid Width="48" Height="48" CornerRadius="10">
                    <Border x:Name="NowTile" Background="#22FFFFFF" />
                    <Image x:Name="NowImage" Stretch="UniformToFill" />
                </Grid>
                <StackPanel VerticalAlignment="Center" MaxWidth="140">
                    <TextBlock x:Name="NowTitle" Text="Nada en reproducción" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtist" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="PlayingBars" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="3" Height="16" Fill="{StaticResource NsAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar1" ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="3" Height="16" Fill="{StaticResource NsAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar2" ScaleY="0.8" /></Rectangle.RenderTransform></Rectangle>
                    <Rectangle Width="3" Height="16" Fill="{StaticResource NsAccentBrush}" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform x:Name="Bar3" ScaleY="0.5" /></Rectangle.RenderTransform></Rectangle>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="2" MaxWidth="720">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Click="Prev_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Anterior" AutomationProperties.Name="Anterior">
                        <SymbolIcon Symbol="Previous" />
                    </Button>
                    <Button Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="44" Height="44" CornerRadius="22" Padding="0"
                            ToolTipService.ToolTip="Reproducir / Pausa" AutomationProperties.Name="Reproducir o pausar">
                        <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
                    </Button>
                    <Button Click="Next_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Siguiente" AutomationProperties.Name="Siguiente">
                        <SymbolIcon Symbol="Next" />
                    </Button>
                </StackPanel>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" Text="0:00" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    <Slider x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False"
                            ValueChanged="Progress_ValueChanged" />
                    <TextBlock x:Name="Total" Grid.Column="2" Text="0:00" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Añadir a una lista" AutomationProperties.Name="Añadir a lista">
                    <SymbolIcon Symbol="Add" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="PlaylistMenu" Opening="PlaylistMenu_Opening" />
                    </Button.Flyout>
                </Button>
                <Button Click="Save_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Guardar en Mi biblioteca" AutomationProperties.Name="Guardar">
                    <FontIcon x:Name="SaveIcon" Glyph="&#xEB51;" />
                </Button>
                <Button Click="Download_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Descargar (contenido libre)" AutomationProperties.Name="Descargar">
                    <SymbolIcon Symbol="Download" />
                </Button>
                <Button Click="Lyrics_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Mostrar u ocultar la letra" AutomationProperties.Name="Letra">
                    <TextBlock Text="Letra" FontWeight="SemiBold" />
                </Button>
                <Button Click="ShowVideo_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Mostrar u ocultar el vídeo" AutomationProperties.Name="Mostrar vídeo">
                    <SymbolIcon Symbol="SlideShow" />
                </Button>
                <SymbolIcon Symbol="Volume" />
                <Slider x:Name="Volume" Width="130" Minimum="0" Maximum="100" Value="80" ValueChanged="Volume_ValueChanged" />
            </StackPanel>
        </Grid>

        <!-- Pantalla «Reproduciendo» -->
        <Grid x:Name="NowSheet" Grid.RowSpan="3" Visibility="Collapsed" Background="{StaticResource NsBgBrush}">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.75">
                        <GradientStop x:Name="NpGlowStop" Color="#66FF4D62" Offset="0" />
                        <GradientStop x:Name="NpGlowEnd" Color="#00FF4D62" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,48,0,0" Width="44" Height="44" CornerRadius="22" Padding="0"
                    Click="NowSheetClose_Click" AutomationProperties.Name="Cerrar">
                <FontIcon Glyph="&#xE70D;" />
            </Button>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="560" Padding="24">
                <Border Width="340" Height="340" CornerRadius="28" Background="{StaticResource NsPanelBrush}" HorizontalAlignment="Center">
                    <Image x:Name="NpImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="NpTitle" FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" />
                <TextBlock x:Name="NpArtist" Opacity="0.7" TextAlignment="Center" />
                <Slider x:Name="NpProgress" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" ValueChanged="Progress_ValueChanged" Margin="0,10,0,0" />
                <Grid>
                    <TextBlock x:Name="NpElapsed" Text="0:00" FontSize="12" Opacity="0.7" />
                    <TextBlock x:Name="NpTotal" Text="0:00" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="18" HorizontalAlignment="Center">
                    <Button Click="Prev_Click" Background="Transparent" BorderThickness="0" Width="56" Height="56" CornerRadius="28" AutomationProperties.Name="Anterior"><SymbolIcon Symbol="Previous" /></Button>
                    <Button Click="Play_Click" Style="{StaticResource AccentButtonStyle}" Width="72" Height="72" CornerRadius="36" Padding="0" AutomationProperties.Name="Reproducir o pausar"><SymbolIcon x:Name="NpPlayIcon" Symbol="Play" /></Button>
                    <Button Click="Next_Click" Background="Transparent" BorderThickness="0" Width="56" Height="56" CornerRadius="28" AutomationProperties.Name="Siguiente"><SymbolIcon Symbol="Next" /></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Click="Save_Click" CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Guardar"><FontIcon x:Name="NpHeartIcon" Glyph="&#xEB51;" /></Button>
                    <Button CornerRadius="14" MinWidth="56" MinHeight="46" AutomationProperties.Name="Añadir a lista">
                        <SymbolIcon Symbol="Add" />
                        <Button.Flyout><MenuFlyout x:Name="PlaylistMenu2" Opening="PlaylistMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button Click="Queue_Click" Content="Cola" CornerRadius="14" MinWidth="56" MinHeight="46" />
