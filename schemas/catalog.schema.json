{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://librestream-hub.github.io/schemas/catalog.schema.json",
  "title": "LibreStream Hub Catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "kind", "title", "artist", "durationSec", "license", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "MD5(normalize(artist) + '|' + normalize(title) + '|' + version) en hex",
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "kind": { "enum": ["track", "video", "episode"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "artist": { "type": "string", "minLength": 1, "maxLength": 200 },
        "featuring": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "version": { "enum": ["original", "remix", "live", "acoustic", "instrumental", "cover", "edit"] },
        "album": { "type": "string" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 },
        "artworkUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "genres": { "type": "array", "items": { "type": "string" } },
        "license": {
          "type": "object",
          "required": ["spdx"],
          "properties": {
            "spdx": { "type": "string", "description": "p.ej. CC-BY-4.0, CC0-1.0, PDM" },
            "attribution": { "type": "string" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["provider", "url"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["direct", "archive_org", "jamendo", "fma", "youtube"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "mime": { "type": "string", "examples": ["audio/mpeg", "application/vnd.apple.mpegurl", "video/mp4"] },
        "bitrateKbps": { "type": "integer", "minimum": 1 },
        "durationSec": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
